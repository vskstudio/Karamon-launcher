{
  "name": "karamon-launcher",
  "version": "2.0.11",
  "description": "Karamon V2 Minecraft Launcher (Cobbleverse)",
  "author": "Karamon",
  "type": "module",
  "main": "dist/main.cjs",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "start": "npx electron .",
    "dev": "npm run build && npm start",
    "prebuild:dist": "node scripts/convert-icon.cjs && node build.mjs",
    "build:dist": "electron-builder --win --x64",
    "prebuild:dist:mac": "node build.mjs",
    "build:dist:mac": "electron-builder --mac",
    "prebuild:dist:linux": "node build.mjs",
    "build:dist:linux": "electron-builder --linux --x64",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "@preact/signals": "^2.11.4",
    "@xhayper/discord-rpc": "^1.5.1",
    "adm-zip": "^0.6.1",
    "electron-updater": "^6.8.11",
    "node-html-parser": "^9.0.7",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "png-to-ico": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild": true,
    "electron-winstaller": true
  }
}
